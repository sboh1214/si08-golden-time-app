{
  "expo": {
    "name": "건강수첩",
    "slug": "golden-time-health-note",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "healthnote",
    "userInterfaceStyle": "light",
    "description": "진료기록을 촬영·업로드하면 AI가 진단명·검사 수치·처방 약물을 정리하고 환자 눈높이로 해설해 주는 건강수첩 환자용 앱 (MVP)",
    "ios": {
      "bundleIdentifier": "kr.goldentime.healthnote",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "kr.goldentime.healthnote",
      "adaptiveIcon": {
        "backgroundColor": "#0E7C6B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E7C6B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "진료기록 사진을 등록하기 위해 사진 보관함에 접근합니다.",
          "cameraPermission": "진료기록을 촬영하기 위해 카메라에 접근합니다.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
