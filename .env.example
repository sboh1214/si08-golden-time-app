# 건강수첩 환자용 앱 — 환경변수 예시
#
# 사용법
#   1) 이 파일을 복사해 `.env.local` 로 저장합니다. (`.env.local` 은 git 에 올라가지 않습니다)
#   2) 값을 바꾼 뒤 개발 서버를 다시 시작합니다:  npx expo start --clear
#
# - EXPO_PUBLIC_ 로 시작하는 값은 번들 시점에 앱 안에 그대로 포함됩니다. 비밀 값(API 키 등)을 넣지 마세요.
# - EAS 클라우드 빌드에는 이 파일이 전달되지 않습니다. 빌드용 값은 eas.json 의 build profile `env` 에 지정합니다.
# - 정의와 기본값: src/api/config.ts

# API 연결 방식
#   mock : 앱 내장 데모 서버 (백엔드 없이 샘플 데이터로 동작, 기본값)
#   http : 실서버 (아래 EXPO_PUBLIC_API_BASE_URL 필요 — 개발 환경에서 비어 있으면 자동으로 mock,
#          beta·production 빌드에서 비어 있거나 example.com 이면 앱이 설정 오류 화면에서 멈춤)
EXPO_PUBLIC_API_MODE=mock

# 실서버 주소 (http 모드에서 사용). 끝의 / 는 자동으로 제거됩니다.
# 계약: docs/API_CONTRACT.md
# EXPO_PUBLIC_API_BASE_URL=https://api.example.com

# 요청 타임아웃 (ms). 문서 업로드는 이 값의 3배 + 파일 용량에 비례한 전송 시간을 사용합니다. 기본 20000
EXPO_PUBLIC_API_TIMEOUT_MS=20000

# 빌드 환경 표시 (설정 > 앱 버전): development | beta | production. 기본 development
EXPO_PUBLIC_APP_ENV=development

# 문의 메일 주소 (설정 › 정보 › '메일로 문의하기'). 비어 있거나 형식이 맞지 않으면 문의 행을 숨깁니다.
# 운영사가 받을 주소를 정하면 eas.json 의 preview·production 프로필 env 에도 같은 값을 넣습니다.
# EXPO_PUBLIC_SUPPORT_EMAIL=
